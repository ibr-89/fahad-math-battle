{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$pin": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.child('hostUid').val() === auth.uid) || data.child('hostUid').val() === auth.uid)",
        "players": {
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || root.child('rooms').child($pin).child('hostUid').val() === auth.uid)",
            ".validate": "!newData.exists() || (newData.hasChildren(['name','score','correct']) && newData.child('name').isString() && newData.child('name').val().length <= 20 && newData.child('score').isNumber() && newData.child('correct').isNumber())"
          }
        },
        "answers": {
          "$questionIndex": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && !data.exists() && root.child('rooms').child($pin).child('status').val() === 'playing' && $questionIndex === root.child('rooms').child($pin).child('currentQuestionIndex').val() + ''",
              ".validate": "newData.hasChildren(['value','elapsedMs']) && newData.child('value').isNumber() && newData.child('elapsedMs').isNumber() && newData.child('elapsedMs').val() >= 0"
            }
          }
        }
      }
    }
  }
}
